# Sno-Haus AP Dashboard — environment variable reference
# Copy this file to .env and fill in your values.
# Never share your .env file — it contains secrets.

# ---- Authentication ----
# Single user (email + scrypt hash):
LOGIN_EMAIL=jake@snohaus.com
LOGIN_PASSWORD_SALT=<hex-encoded-salt>
LOGIN_PASSWORD_HASH=<hex-encoded-scrypt-hash>

# Multiple users (email:salt:hash triples, comma-separated):
# LOGIN_USERS=jake@snohaus.com:salt1:hash1,admin@snohaus.com:salt2:hash2

# Allowed login emails (comma-separated). Users outside this list are rejected.
ALLOWED_EMAILS=jake@snohaus.com,jake@sundowngreenvale.com,admin@snohaus.com,johnny@snohaus.com

# Session signing secret. Auto-generated on first start if left blank.
SESSION_SECRET=<random-hex-string>

# ---- QuickBooks Online ----
# 1. Go to https://developer.intuit.com and sign in
# 2. Create an app, select "QuickBooks Online Accounting" scope
# 3. Copy Client ID and Secret from the app's Keys & credentials page
# 4. Add http://localhost:5000/api/qbo/callback as a Redirect URI

QBO_CLIENT_ID=<your-qbo-client-id>
QBO_CLIENT_SECRET=<your-qbo-client-secret>

# "sandbox" uses test data; "production" hits your real QBO company
QBO_ENVIRONMENT=sandbox

# Must match exactly what you set in your QBO app's Redirect URIs
QBO_REDIRECT_URI=http://localhost:5000/api/qbo/callback

# ---- Gmail Invoice Intake ----
# 1. Enable 2-Step Verification on the Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password (Mail + Other)
# 4. Paste the 16-character password (without spaces) below

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxxxxxx

# Gmail label to watch for invoice emails (create this label in Gmail)
GMAIL_LABEL=Unreceived Invoices

# How often to check for new emails (in minutes)
GMAIL_POLL_INTERVAL_MINUTES=15

# ---- R4q: Gmail API (push-based, replaces IMAP eventually) ----
# When true, the server also runs the Gmail API ingest path in parallel with
# IMAP. Both paths share the ingested_emails dedup table so no duplicate
# invoices are created. After ~1-2 weeks of confirmed reliability, R4r will
# delete the IMAP path entirely.
#
# Setup: Settings -> Integrations -> Connect Gmail (OAuth). Watch is
# auto-registered and renewed every 6 days. Pub/Sub push notifications hit
# /api/gmail/push. See README "Gmail API migration" for full setup.
#
# Leave unset (or =false) to run IMAP-only.
GMAIL_API_ENABLED=false

# Optional overrides for the Gmail API path (defaults shown):
# GMAIL_LOOKBACK_DAYS=7              # Fallback poll lookback (IMAP was 30)
# GMAIL_POLL_INTERVAL_MINUTES=60     # Safety-net poll (push is primary; longer is fine)

# ---- Google OAuth (SSO + Drive backups + Gmail API) ----
# 1. Go to https://console.cloud.google.com
# 2. Create a project, enable Google Drive API + Google Identity API
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add your redirect URIs for local dev and production (ngrok)
# These enable:
#   - "Sign in with Google" on the login page
#   - Google Drive backup uploads
#   - PDF archive uploads to Drive
#
# Leave blank to disable Google features (app degrades gracefully).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_LOCAL=http://localhost:5000/api/auth/google/callback
GOOGLE_REDIRECT_URI_PROD=https://your-ngrok-subdomain.ngrok-free.dev/api/auth/google/callback

# ---- Shopify Reconciler (PR #R2+, client_credentials via PR #R2d) ----
# 1. Shopify Partner Dashboard -> Sno-Haus Reconciler app -> App credentials
# 2. Copy the Client ID and Client Secret. The server mints short-lived
#    Admin API tokens (shpat_...) via the OAuth 2.0 client_credentials grant
#    on every server start and refreshes every ~23h — no manual tokens needed.
# 3. Public base URL = your stable ngrok domain. Webhook endpoint will be
#    SHOPIFY_PUBLIC_BASE_URL + /webhooks/shopify
#
# SHOPIFY_ADMIN_TOKEN is an OPTIONAL override for testing with a hand-minted
# token — leave blank in normal operation.

SHOPIFY_SHOP_DOMAIN=sundown-ski-patio-greenvale.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-04
SHOPIFY_PUBLIC_BASE_URL=https://disabled-drizzle-unplowed.ngrok-free.dev
# SHOPIFY_ADMIN_TOKEN=  # optional static-token override (testing only)
